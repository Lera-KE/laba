#include <stdio.h>
#include <stdlib.h>


int natural(const char *str) {
	if (str[0] == '\0' || str[0] == '0' || str[0] == '-')
	{
		return 0;
	}
	for (int i = 0; str[i] != '\0'; i++) {
		if (str[i] < '0' || str[i] > '9') {
			return 0;
		}
	}
	return 1;
}



int integer(const char *str) {
	int start = 0;
	if (str[0] == '-' || str[0] == '+') {
		start += 1;
	}
	if (str[start] == '\0') {
	return 0;
	}

	for (int i = start; str[i] != '\0'; i++) {
		if (str[i] < '0' || str[i] > '9') {
			return 0;
		}
	}
	return 1;
}


int float_str(const char *str) {
	int start = 0;
	if (str[0] == '-' || str[0] == '+') {
		start += 1;
	}

	if (str[start] == '\0') {
		return 0;
	}

	int dot_count = 0;
	int digit_count = 0;

	for (int i = start; str[i] != '\0'; i++) {
		if (str[i] == '.') {
			dot_count++;
			if (dot_count > 1) {
				return 0;
			}
		} else {
			if (str[i] >= '0' && str[i] <= '9') {
				digit_count++;
			}
			else {
				return 0;
			}
		}
		if (digit_count == 0) {
			return 0;
		}
	}
	return 1; 	 	 	
}


int main() {
	char *N_str = NULL;
	char *M_str = NULL;
	int M, N;

	while (1) {
		printf("Введите N: ");
		if (scanf("%ms", &N_str) != 1) {
			printf("Ошибка чтения. \n");
			free(N_str);
			continue;
		}
		if (natural(N_str)) {
			N = atoi(N_str);
			free(N_str);
			break;
		} else {
			free(N_str);
			printf("Число должно быть натуральным. \n");
		}
	}
	while (1) {
                printf("Введите M: ");
                if (scanf("%ms", &M_str) != 1) {
                        printf("Ошибка чтения. \n");
                        free(M_str);
                	continue;
                }
        	if (natural(M_str)) {
                	M = atoi(M_str);
        		free(M_str);
        		break;
        	} else {
        		free(M_str);
        		printf("Число должно быть натуральным. \n");
        	}
        }

	if (N < 5 || M < 4) {
		printf("Некорретные данные для задачи.\n");
		return 1;
	}

	float *Matrix = malloc(M * N * sizeof(*Matrix));

	if (Matrix == NULL) {
		printf("Ошибка выделения памяти.\n");
		return 1;
	}

	for (int i = 0; i < N; i++) {
		for ( int j = 0; j < M; j++) {
			char *element = NULL;
			float value;

			while (1) {
				printf("Введите элемент [%i][%i]: ", i, j);
				if (scanf("%ms", &element) != 1) {
					printf("Ошибка чтения. \n");
					free(element);
					break;
				} if (float_str(element)) {
					value = atoi(element);
        				free(element);
        				break;
				}
				else {
					free(element);
					printf("Некорректный ввод. \n");
				}
			}
			Matrix[i * M + j] = value;
		}
	}


	float max = Matrix[0];
	int maxi = 0;
	int maxj = 0;

	for (int i = 0; i < N; i++) {
		for (int j = 0; j < 4; j++) {
			if (Matrix[i * M + j] > max) {
			max = Matrix[i * M + j];
			maxi = i;
			maxj = j;
			}
		}
	}

	float s = 0;
	float del = Matrix[3 * M + 2];

	if (del == 0) {
		printf("Деление на 0 невозможно.\n");
		free(Matrix);
		return 1;
	}

	for (int i = 0; i < N; i++) {
		float ai2 = Matrix[i * M + 1];
		s += (ai2 + ai2 * ai2) / del;
	}

	printf("Сумма = %f\n", s);

	Matrix[maxi * M + maxj] = s;

	for (int i = 0; i < N; i++) {
		for (int j = 0; j < M; j++) {
			printf("| %f |", Matrix[i * M + j]);
		}
		printf("\n");
	}
	free(Matrix); // освобождение памяти.
	return 0;
}

